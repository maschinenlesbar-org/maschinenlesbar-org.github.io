---
# The sitemap of this site: the home pages, the blog indexes and every post, in both
# languages. The plugin marketplace and the CLI websites have their own, listed in
# robots.txt.
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | sort: "url" %}
{%- for p in pages %}
{%- assign last = p.url | slice: -1 %}
{%- if last != "/" or p.sitemap == false %}{% continue %}{% endif %}
  <url><loc>{{ p.url | absolute_url | xml_escape }}</loc></url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
